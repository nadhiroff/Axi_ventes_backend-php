# Copier en .env puis compléter. Ne jamais versionner .env.
# local : codes email aussi écrits dans storage/logs/mail.log, paiement factice, messages d'erreur détaillés
APP_ENV=local
# Clé des codes email (HMAC). Générer : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=
# URL publique de l'API (vide = déduite de la requête), ex. https://api.axi.bj
APP_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=axi
DB_USER=
DB_PASS=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
# Gmail : « mot de passe d'application » (16 lettres), pas le mot de passe du compte
MAIL_PASSWORD=
MAIL_FROM_NAME=Axi
# Origines web autorisées (Expo web), séparées par des virgules
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TOKEN_TTL_DAYS=90
